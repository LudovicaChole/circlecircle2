$=============================================================
$                  OUTPUT CONTROL CARD
$=============================================================
OCTRL /  
 TIME_HISTORY                 INTERVAL 0.1
 CONTOUR_PLOT                 INTERVAL 5.
 PRTOUTPUT                    CYCLE 1000
$-------------------------------------------------------------
$ --> Standarts Outputs (can be modified by users if needed)
$-------------------------------------------------------------
$===========> TIME_HISTORY_OUTPUT_CONTROL
 PREFILTER                    YES ALL
 PREFILTER_NO_SHIFT           
$-----------> Global
 GLBTHP                       ALL
$-----------> Solid
 SOLTHP                       NO
$-----------> Shell
 SHLTHP                       NO
$-----------> Beam
 BEATHP                       DFLT
$===========> PLOT_OUTPUT_CONTROL
$-----------> Nodal : Dyn Mass Scaling
 NODPLOT                      FACM
$-----------> FPM
 FPMPLOT                      NO
$-----------> Layer
 LAYPLOT                      DAMX THIC EPSP SRAL DAMF EPSL SIGL
$-----------> Smooth_Particle
 SPHPLOT                      NO
$-----------> Contact
 CNTPLOT                      NO
$-----------> Beam
 BEAPLOT                      NO
$-----------> BEAM : Init Mass Scal
$$$$$ BEAPLOT IMSC
$-----------> Collector
 COLOUTPUT                    MTOCO OTMCO PLINK RBODY TIED
$-----------> Solid
 SOLPLOT                      NO
$-----------> Solid : NTNU Failure Risk & Damage
 SOLPLOT                      FDMG FFAIL
$-----------> Solid : Init Mass Scal, Dyn Stifness Scale
$$$$$ SOLPLOT IMSC STSC
$-----------> SHELL : Max / Min / Membrane Plastic Strain over thickness
 SHLPLOT                      EPMX EPME
$-----------> SHELL : Max / Min / Membrane Equivalent Stress : Von Mises
$ SHLPLOT ESMA
$-----------> SHELL : NTNU Failure Risk & Damage
 SHLPLOT                      FDMG FFAIL THIC
 RANPLOT                      DFLT
 RANTHP                       DFLT
 SURFPLOT                     DFLT
 SURFTHP                      DFLT
$-----------> SHELL : Init Mass Scal, Dyn Stifness Scale
$$$$$ SHLPLOT IMSC STSC
END_OCTRL
$=============================================================
$                  PRINT CONTROL CARD
$=============================================================
PRCTRL/  
 PRINT_ALL                    NO
 PRINT_DFLT                   NO
$ Print Input data (Only those differents from default value)
                              DELEM_INPUT NO
                              MTOCO_INPUT YES
                              MUSCLE_INPUT NO
                              OTMCO_INPUT YES
                              PYVAR_INPUT YES
                              RBODY_INPUT YES
                              RMLOAD_INPUT NO
                              SECFO_INPUT NO
                              SEWING_INPUT NO
                              TRSFM_INPUT YES
                              TURBL_INPUT NO
                              MATER_INPUT YES
$-------------------------------------------------------------
$ > YES for checking the 1st time and then NO (file size)
$-------------------------------------------------------------
$ To identify contact penetrations
                              CNTAC_INIT NO
$ To know Mass / Inertia ...
                              MTOCO_INIT NO
                              OTMCO_INIT NO
                              RBODY_INIT NO
$ To know Projections and distances
                              PLINK_INIT YES
                              TIED_INIT NO
$-------------------------------------------------------------
$ > YES for print control of solution information and then NO (file size)
$-------------------------------------------------------------
                              THELE_SOLU YES
END_PRCTRL
$=============================================================
$                  ERF CONTROL CARD
$=============================================================
EOCTRL/  
$ VPS2020 Default = YES  / Renault = NO (FemZip used)
 COMPRESSION                  NO
$ VPS2020 Default = YES  / Renault = NO TBC
 STRIPPED_INPUT               NO
END_EOCTRL
$=============================================================
$                  TIME STEP CONTROL CARD
$=============================================================
TCTRL /  
 INIT_MASS_SCALE              0.0005
 STIFFNESS_SCALE              0.0005 0.3
 DYNA_MASS_SCALE              0.0005 10. 0
$
$ VPS2020 Default = Renault Std
 SHELL_TIMESTEP               SMALL NOBEND NU
END_TCTRL
$=============================================================
$                  METRIC CONTROL CARD
$=============================================================
MCTRL /  
 INDPT_METRIC_FILE_READING    YES
END_MCTRL
$=============================================================
$                  ELEMENT CONTROL CARD
$=============================================================
ECTRL /  
 RATEFILTER_TIME              0.047
 RATECURVE                    LOG
 STRAINRATE                   YES
$ VPS2020 Default = Renault Std
 ANTIDRILL                    PROJECTION_RBODY
$
 POST_CUTOFF_SLOPE            0.03
 METRIC_3D_LOAD               1000 0.0001
$ Renault Std != VPS2020 Default
 BEAM_FORMULATION             2
 THICKNESS_INTEGRATION        UNIFORM
END_ECTRL
$=============================================================
$                  CONTACT CONTROL CARD
$=============================================================
$ VPS2020 Default = Renault Std
CCTRL /  
 ITER_INIPEN_N                100
 ITER_FORCE_N                 300
 ITER_FORCE_EPS               0.001
END_CCTRL
CKCTRL/  
 SHELL_GEOMETRY_FATAL         WARNING
 SOLID_GEOMETRY_FATAL         WARNING
END_CKCTRL
$=============================================================
$                  CHECK CONTROL CARD
$=============================================================
$ CKCTRL/
$  CNTAC_PENETRATION_REMOVAL  WARNING   HCONT_MIN  0.4
$  CNTAC_PENETRATION_DEPTH    WARNING   PENET_MAX  0.3
$ END_CKCTRL
$=============================================================
